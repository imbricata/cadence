// Copy this file to Secrets.xcconfig and fill in your Google OAuth client IDs.
// Do NOT commit Secrets.xcconfig (it is git-ignored).
//
// Cadence uses ASWebAuthenticationSession + PKCE (no Google SDK).
// Create two OAuth clients in Google Cloud Console:
//   1. Application type "iOS"     -> bundle ID "com.cadence.ios"   -> GOOGLE_IOS_CLIENT_ID
//   2. Application type "Desktop"  -> for the Mac app               -> GOOGLE_MAC_CLIENT_ID
// Add the authorized redirect URI for BOTH clients:
//   cadence://oauth2redirect
//
// If a value is left empty the corresponding app just shows "not connected".

GOOGLE_IOS_CLIENT_ID =
GOOGLE_MAC_CLIENT_ID =