// Copy this file to Secrets.xcconfig and fill in your Google OAuth client ID.
// Do NOT commit Secrets.xcconfig (it is git-ignored).
//
// Create ONE OAuth client in Google Cloud Console:
//   Application type: "Web application"   (works for both iPhone and Mac with PKCE)
//   Name: Cadence
//   Authorized redirect URI:  cadence://oauth2redirect
//   (leave "Client secret" blank; Cadence uses PKCE and does not need it)
//
// Paste the same Client ID into both fields below (or use two clients if you prefer).
//
// If a value is left empty the corresponding app just shows "not connected".

GOOGLE_IOS_CLIENT_ID =
GOOGLE_MAC_CLIENT_ID =