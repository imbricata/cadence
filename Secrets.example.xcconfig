// Copy to Secrets.xcconfig (git-ignored) and fill in. Never commit Secrets.xcconfig.
//
// Create two OAuth clients in Google Cloud Console, both of type "iOS":
//   iPhone app -> bundle ID com.theocoronges.cadence -> GOOGLE_IOS_CLIENT_ID
//   Mac app    -> bundle ID com.theocoronges.cadence.mac -> GOOGLE_MAC_CLIENT_ID
// Paste the full Client ID, e.g. 1234-abcd.apps.googleusercontent.com
// No client secret is needed (PKCE). Empty value = app shows "not connected".

GOOGLE_IOS_CLIENT_ID =
GOOGLE_MAC_CLIENT_ID =
