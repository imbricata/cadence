{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "permission": {
    "*": "allow",
    "question": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/Library/Developer/**": "allow",
      "/tmp/**": "allow",
      "/private/var/folders/**": "allow"
    }
  }
}
